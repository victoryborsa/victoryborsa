# PostgreSQL connection string (Neon, Render, Supabase, or any Postgres 14+)
DATABASE_URL=postgres://sevgio:sevgio@localhost:5432/sevgio

# Public address of the site, used in emails and calendar links
SITE_URL=http://localhost:3000

# Email (optional). Without these, emails are written to the server log instead of sent.
# Works with GoDaddy/Microsoft 365, Google Workspace, Resend, Postmark, SendGrid SMTP, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Sevgio <hello@sevgio.com>"

# Secret used by the scheduled job that re-imports Airbnb/Vrbo calendars
CRON_SECRET=change-me-to-a-long-random-string
