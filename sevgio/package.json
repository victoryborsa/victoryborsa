{
  "name": "sevgio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "migrate": "node scripts/migrate.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 --experimental-strip-types tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "start:host": "node scripts/migrate.mjs && node scripts/bootstrap.mjs && next start",
    "postinstall": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "bcryptjs": "3.0.3",
    "maplibre-gl": "6.11.2",
    "next": "15.5.26",
    "nodemailer": "10.0.12",
    "pg": "8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
