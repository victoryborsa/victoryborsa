# ---- Required ----
NODE_ENV=production
# Your admin login password (10+ characters)
ADMIN_PASSWORD=
# Random secret, 32+ characters (e.g. run: openssl rand -hex 32)
SESSION_SECRET=
# The public web address of this back office (no trailing slash)
PUBLIC_URL=https://admin.pghshinepro.com

# ---- Who gets NEW LEAD alerts (comma separated) ----
# Turn on Gmail notifications on your phone to see these instantly.
ALERT_EMAILS=pghshinepro@gmail.com

# ---- Email sending (Gmail: use an App Password, not your normal password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Where customer email replies go (defaults to EMAIL_FROM)
EMAIL_REPLY_TO=

# ---- Texting: Google Voice ----
# The admin's "Text via Google Voice" button opens this number's Google Voice inbox.
GOOGLE_VOICE_NUMBER=(412) 447-8047

# ---- Prices ----
# Prices live ONLY in public/pricing.js. The server recalculates every estimate it receives
# (a price sent by the browser is ignored) and adds the $20 travel fee to every visit.

# ---- The public website ----
# Origins allowed to post to /api/leads, /api/contact, /api/newsletter and /api/forms (comma separated).
SITE_ORIGINS=https://pghshinepro.com,https://www.pghshinepro.com

# ---- Email/text retries ----
# A failed email or text is tried 3 times in total. Wait (ms) before the 2nd and 3rd try.
NOTIFY_RETRY_DELAYS_MS=5000,30000

# ---- Website chat: AI assistant ----
# Create a key at console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# AI model used by the chat assistant
AI_MODEL=claude-opus-5-5

# ---- Website chat: how customers start ----
# none  = (default) customer types name, email and phone, then chats right away
# codes = customer must also enter an emailed code and a texted code (needs SMTP + Firebase below)
CHAT_VERIFICATION=none

# ---- Website chat: phone verification (Firebase, by Google). Only used with CHAT_VERIFICATION=codes ----
# Firebase console -> Project settings -> Your apps -> Web app config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
# With CHAT_VERIFICATION=codes keep true. (false = codes mode without phone codes; local testing ONLY)
REQUIRE_PHONE_VERIFICATION=true

# ---- OPTIONAL, not used by default: automatic texting via Twilio ----
# Leave blank to use Google Voice. Only fill in if you later want fully automatic texts.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# ALERT_PHONES=

# ---- Optional ----
BUSINESS_NAME=Shine Pro Cleaning
BUSINESS_PHONE=(412) 447-8047
# Websites allowed to submit the quote form
ALLOWED_ORIGINS=https://pghshinepro.com,https://www.pghshinepro.com
# Email customers an automatic "we got your request" message
SEND_CUSTOMER_CONFIRMATION=true
# Database location (put it on a persistent disk!)
DATABASE_FILE=./data/shinepro.db

# ---- Client & host portals ----
# Turnover report photos are saved here (defaults to an "uploads" folder next to DATABASE_FILE,
# so they sit on the same persistent disk). Only the owning host and the admin can view them.
# UPLOADS_DIR=/var/data/uploads
# Largest photo the admin can upload, in MB
UPLOAD_MAX_MB=8
