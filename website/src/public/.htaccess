# PGH Shine Pro — Apache settings for GoDaddy hosting

ErrorDocument 404 /404.html
DirectoryIndex index.html

# Old pages that showed the same content as another page.
<IfModule mod_alias.c>
  Redirect 301 /post-construction-cleaning /deep-cleaning
  Redirect 301 /special-event-cleaning /event-cleanup
  Redirect 301 /eco-friendly-cleaning /house-cleaning
  Redirect 301 /upholstery-cleaning /services

  # Client and host portals run on the back office server.
  # Change the address below if the back office lives somewhere else.
  Redirect 302 /portal https://admin.pghshinepro.com/portal
  Redirect 302 /host https://admin.pghshinepro.com/host
</IfModule>

# Send visitors to the secure https:// address.
# Remove the four lines below if your GoDaddy plan has no SSL certificate yet.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
